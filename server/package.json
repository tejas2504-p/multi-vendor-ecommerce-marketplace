{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API server for Multi-Vendor E-Commerce Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "test:auth": "tsx src/tests/runAuthTests.ts",
    "test:rbac": "tsx src/tests/runRbacTests.ts",
    "test:vendor": "tsx src/tests/runVendorOnboardingTests.ts",
    "test:approval": "tsx src/tests/runAdminVendorApprovalTests.ts",
    "test": "tsx src/tests/runAuthTests.ts && tsx src/tests/runRbacTests.ts && tsx src/tests/runVendorOnboardingTests.ts && tsx src/tests/runAdminVendorApprovalTests.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "@elastic/elasticsearch": "^8.13.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.1",
    "morgan": "^1.10.0",
    "rate-limit-redis": "^4.2.0",
    "stripe": "^15.1.0",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "rimraf": "^5.0.5",
    "supertest": "^7.3.1",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}

# =============================================================================
# NEXUSMARKET BACKEND PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to .env or configure these variables in Render / Hosting provider dashboard.
# DO NOT commit real secrets or production keys to version control.
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=10000
# Deployed frontend URL on Vercel (supports multiple comma-separated origins)
CLIENT_URL=https://nexusmarket.vercel.app

# Database (MongoDB Atlas)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/marketplace?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/marketplace?retryWrites=true&w=majority

# Redis Cache (Upstash Redis, Redis Cloud, or Render Redis)
# Example: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=rediss://default:<password>@<host>:<port>

# Elasticsearch (Managed Elastic Cloud, Bonsai, or Search Cluster)
# Example: https://<cluster-id>.es.<region>.aws.elastic.cloud:443
ELASTICSEARCH_NODE=https://<cluster-id>.es.<region>.aws.elastic.cloud:443
ELASTICSEARCH_INDEX=marketplace_products
ELASTICSEARCH_API_KEY=<your-elasticsearch-api-key>

# JWT Authentication (Generate random 32+ char secrets: `openssl rand -base64 32`)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRY=7d

# AWS S3 Storage (Product image uploads & PDF invoices)
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=nexusmarket-production-assets
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>

# Razorpay Payment Gateway (Test or Live mode)
RAZORPAY_KEY_ID=rzp_test_<your-key-id>
RAZORPAY_KEY_SECRET=<your-razorpay-secret>
RAZORPAY_WEBHOOK_SECRET=<your-webhook-secret>

# UPI Dynamic Payment Configuration
MERCHANT_UPI_VPA=tejasprajapati2504@oksbi
MERCHANT_NAME=NexusMarket

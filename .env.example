# ==============================================================================
# Multi-Vendor E-Commerce Marketplace - Environment Variables
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Core Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000

# Primary Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/marketplace

# In-Memory Cache & Session Store (Redis - Future Phase)
REDIS_URL=redis://localhost:6379

# Search & Discovery Engine (Elasticsearch - Future Phase)
ELASTICSEARCH_NODE=http://localhost:9200

# Authentication & Security (JWT)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_chars
JWT_REFRESH_EXPIRY=7d

# Media Asset Storage (AWS S3 - Future Phase)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_placeholder
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_placeholder
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=marketplace-assets

# Payment Gateway (Stripe Connect / Razorpay - Future Phase)
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

